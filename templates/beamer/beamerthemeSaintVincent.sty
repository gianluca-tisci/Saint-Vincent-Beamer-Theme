%% beamerthemeSaintVincent.sty
%% ===========================================================================
%% Saint Vincent -- a clean Beamer theme built on almacore.
%% Author: Gianluca Tisci
%% License: MIT (see LICENSE)
%% ===========================================================================
%%
%% USAGE
%%   \documentclass[aspectratio=169]{beamer}
%%   \usetheme{SaintVincent}
%%
%% OPTIONS
%%   night           Dark colour scheme.
%%   nosectionslides Do not insert a divider slide at each \section.
%%   sectiontoc      At each \section, show the table of contents with the
%%                   current section highlighted instead of a divider slide.
%%                   The slide title is \svtoctitle (default "Overview").
%%   (options not listed here are forwarded to almacore: hidememo, wiggle=,
%%    nographs)
%%
%% FONTS
%% This theme loads NO font package and never changes \familydefault. Slides
%% use Beamer's own default family. Everything is styled by size, weight and
%% colour only -- the same rule the whole alma / Saint Vincent family follows.
%%
%% RELATION TO SIMPLEPLUS
%% Earlier versions of this repository called \usetheme{SimplePlus} without
%% shipping that theme, so the deck did not build from a fresh clone. This
%% theme is standalone: it depends on nothing outside Beamer and almacore.
%% ===========================================================================

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemeSaintVincent}[2026/10/28 v1.1 Saint Vincent theme]

\RequirePackage{kvoptions}
\SetupKeyvalOptions{family=sv, prefix=sv@}
\DeclareBoolOption{night}
\DeclareBoolOption{nosectionslides}
\DeclareBoolOption{sectiontoc}
\DeclareDefaultOption{\PassOptionsToPackage{\CurrentOption}{almacore}}
\ProcessKeyvalOptions*

\mode<presentation>

\RequirePackage{almacore}


%=============================================================================
%  COLOURS
%-----------------------------------------------------------------------------
% The accent comes from almacore, so the slides, the notes class and the
% problem-set template are all the same blue. Re-brand once in almacore.sty
% and every template follows.
%=============================================================================

\ifsv@night
  \definecolor{svbg}{HTML}{14181D}
  \definecolor{svfg}{HTML}{E8EAED}
  \colorlet{svaccent}{almaaccent!45!white}
  \colorlet{svmuted}{svfg!55!svbg}
  \colorlet{svalert}{almaalert!65!white}
\else
  \definecolor{svbg}{HTML}{FFFFFF}
  \definecolor{svfg}{HTML}{1A1A1A}
  \colorlet{svaccent}{almaaccent}
  \colorlet{svmuted}{almamuted}
  \colorlet{svalert}{almaalert}
\fi

\setbeamercolor{normal text}{fg=svfg, bg=svbg}
\setbeamercolor{structure}{fg=svaccent}
\setbeamercolor{alerted text}{fg=svalert}
% Every tint below is mixed explicitly against svbg. Writing `svaccent!8'
% would mix against WHITE regardless of theme, which in night mode produced
% near-white block bodies on a near-black slide.
\setbeamercolor{title}{fg=svaccent}
\setbeamercolor{subtitle}{fg=svaccent}
\setbeamercolor{author}{fg=svfg}
\setbeamercolor{institute}{fg=svmuted}
\setbeamercolor{date}{fg=svmuted}
\setbeamercolor{frametitle}{fg=svaccent, bg=svbg}
\setbeamercolor{framesubtitle}{fg=svmuted, bg=svbg}
% The footer is a solid accent bar; its side texts are a tint of the bar so
% the section name in the middle reads first.
\setbeamercolor{footline}{fg=svbg, bg=svaccent}
\colorlet{svfootside}{svbg!78!svaccent}
\setbeamercolor{itemize item}{fg=svaccent}
\setbeamercolor{itemize subitem}{fg=svaccent!75}
\setbeamercolor{enumerate item}{fg=svaccent}
\setbeamercolor{caption name}{fg=svaccent}
\setbeamercolor{section in toc}{fg=svaccent}
\setbeamercolor{subsection in toc}{fg=svfg}

% Blocks. `block' carries the accent; `alertblock' is the one place a second
% colour is warranted, since an alert that looks like everything else is not
% an alert. `example' stays neutral rather than introducing a third hue.
\setbeamercolor{block title}{fg=svbg, bg=svaccent}
\setbeamercolor{block body}{fg=svfg, bg=svaccent!12!svbg}
% almaalert stays a dark red in both schemes, so its title always needs light
% text -- svbg would be dark-on-dark-red in night mode.
\setbeamercolor{block title alerted}{fg=white, bg=almaalert}
\setbeamercolor{block body alerted}{fg=svfg, bg=svalert!12!svbg}
\setbeamercolor{block title example}{fg=svfg, bg=svmuted!35!svbg}
\setbeamercolor{block body example}{fg=svfg, bg=svmuted!12!svbg}

\setbeamercolor{palette primary}{fg=svbg, bg=svaccent}
\setbeamercolor{titlelike}{fg=svaccent}


%=============================================================================
%  FONT SIZES AND WEIGHTS
%-----------------------------------------------------------------------------
% Sizes and weights only. No \setbeamerfont{...}{family=...} anywhere.
%=============================================================================

\setbeamerfont{title}{size=\Large, series=\bfseries}
\setbeamerfont{subtitle}{size=\normalsize, series=\bfseries}
\setbeamerfont{frametitle}{size=\Large, series=\bfseries}
\setbeamerfont{framesubtitle}{size=\footnotesize, series=\mdseries}
\setbeamerfont{author}{size=\large}
\setbeamerfont{institute}{size=\small}
\setbeamerfont{date}{size=\scriptsize}
\setbeamerfont{block title}{size=\normalsize, series=\bfseries}
\setbeamerfont{footline}{size=\tiny}
\setbeamerfont{section in toc}{size=\large, series=\bfseries}
\setbeamerfont{subsection in toc}{size=\small, series=\mdseries}
\setbeamerfont{caption}{size=\small}
\setbeamerfont{caption name}{series=\bfseries}


%=============================================================================
%  STRUCTURAL TEMPLATES
%=============================================================================

% The navigation symbols cost a corner of every slide and nobody clicks them.
\setbeamertemplate{navigation symbols}{}

\setbeamertemplate{itemize items}[circle]
\setbeamertemplate{itemize subitem}[circle]
\setbeamertemplate{itemize subsubitem}{\scriptsize$-$}
\setbeamertemplate{blocks}[rounded][shadow=false]
\setbeamertemplate{caption}[numbered]

% --- Margins ---------------------------------------------------------------
% One margin for the body, the frame title and the footer, so their left
% edges line up.
\newlength{\svmargin}
\setlength{\svmargin}{2em}
\setbeamersize{text margin left=\svmargin, text margin right=\svmargin}

% --- Frame title: title, thin rule, optional subtitle below the rule --------
% The box is \paperwidth wide with the margins as skips, so the rule must be
% \paperwidth minus both margins; a fixed fraction of \paperwidth overflowed.
\setbeamertemplate{frametitle}{%
  \nointerlineskip
  \vspace{0.6em}%
  \begin{beamercolorbox}[wd=\paperwidth, leftskip=\svmargin, rightskip=\svmargin]{frametitle}
    % Ragged right without \raggedright, which would reset \leftskip to zero.
    \rightskip=\dimexpr\svmargin\relax plus 1fil\relax\usebeamerfont{frametitle}\strut\insertframetitle\strut\par
    \nointerlineskip\vskip0.15em
    \leavevmode{\color{svaccent}\rule{\dimexpr\paperwidth-2\svmargin\relax}{0.4pt}}\par
    \ifx\insertframesubtitle\@empty\else
      \vspace{0.15em}%
      {\usebeamerfont{framesubtitle}\usebeamercolor[fg]{framesubtitle}%
       \insertframesubtitle\par}%
    \fi
  \end{beamercolorbox}
  \vspace{0.3em}%
}

% --- Footline: solid bar with short title | section | page / total --------
% Widths are fractions of the bar's inner width, written out because
% \textwidth is not the body width while the footline is typeset.
\setbeamertemplate{footline}{%
  \begin{beamercolorbox}[wd=\paperwidth, ht=2.25ex, dp=1.25ex,
                         leftskip=\svmargin, rightskip=\svmargin]{footline}%
    \usebeamerfont{footline}%
    % \leavevmode: a minipage met in vertical mode would be stacked above the
    % bar instead of starting the line.
    \leavevmode
    \begin{minipage}[t]{\dimexpr(\paperwidth-2\svmargin)*30/100\relax}\raggedright
      \textcolor{svfootside}{\insertshorttitle}%
    \end{minipage}\hfill
    \begin{minipage}[t]{\dimexpr(\paperwidth-2\svmargin)*38/100\relax}\centering
      \insertsectionhead
    \end{minipage}\hfill
    \begin{minipage}[t]{\dimexpr(\paperwidth-2\svmargin)*30/100\relax}\raggedleft
      \textcolor{svfootside}{\insertframenumber{} / \inserttotalframenumber}%
    \end{minipage}%
  \end{beamercolorbox}%
}

% --- Title page: centred stack, title graphic (e.g. a logo) at the bottom --
\setbeamertemplate{title page}{%
  \vfill
  \begingroup
  \centering
  \begin{beamercolorbox}[sep=10pt, center]{title}
    \usebeamerfont{title}\inserttitle\par
    \ifx\insertsubtitle\@empty\else
      \vskip0.25em
      {\usebeamerfont{subtitle}\usebeamercolor[fg]{subtitle}\insertsubtitle\par}%
    \fi
  \end{beamercolorbox}%
  \vskip0.5em\par
  \begin{beamercolorbox}[sep=8pt, center]{author}
    \usebeamerfont{author}\insertauthor
  \end{beamercolorbox}
  \vskip-1em
  \begin{beamercolorbox}[sep=8pt, center]{institute}
    \usebeamerfont{institute}\insertinstitute
  \end{beamercolorbox}
  \begin{beamercolorbox}[sep=8pt, center]{date}
    \usebeamerfont{date}\insertdate
  \end{beamercolorbox}\vskip0.5em
  {\inserttitlegraphic\par}
  \endgroup
  \vfill
}

% --- Section divider --------------------------------------------------------
\setbeamertemplate{section page}{%
  \begin{center}
    \vfill
    {\usebeamerfont{frametitle}\usebeamercolor[fg]{title}%
     \Large\insertsectionhead\par}
    \vspace{0.6em}
    {\color{svaccent}\rule{0.35\paperwidth}{1pt}}
    \vfill
  \end{center}
}

\newcommand{\svtoctitle}{Overview}

\ifsv@nosectionslides\else
  \ifsv@sectiontoc
    \AtBeginSection[]{%
      \begin{frame}[noframenumbering]{\svtoctitle}
        \tableofcontents[currentsection]
      \end{frame}%
    }
  \else
    \AtBeginSection[]{%
      \begin{frame}[plain, noframenumbering]
        \sectionpage
      \end{frame}%
    }
  \fi
\fi

% --- Table of contents: numbered sections, subsections as 3.1, 3.2 --------
% Beamer's own `sections numbered' template, so \tableofcontents[currentsection]
% greys out the other sections automatically.
\setbeamertemplate{section in toc}[sections numbered]
\setbeamertemplate{subsection in toc}{%
  \leavevmode\leftskip=3.2em%
  \rlap{\hskip-2em\inserttocsectionnumber.\inserttocsubsectionnumber}%
  \inserttocsubsection\par
}

\mode<all>
\endinput
